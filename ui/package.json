{
  "type": "module",
  "private": true,
  "scripts": {
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "check": "run-s format:check lint type-check test:unit",
    "dev": "vite build --watch --mode=development",
    "format": "prettier src/ --write",
    "format:check": "prettier src/ --check",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "lint": "run-s \"lint:*\"",
    "test:unit": "vitest --passWithNoTests",
    "type-check": "vue-tsc --build"
  },
  "dependencies": {
    "@formkit/core": "2.1.0",
    "@formkit/vue": "2.1.0",
    "@halo-dev/api-client": "^2.26.0",
    "@halo-dev/components": "^2.26.0",
    "@halo-dev/ui-shared": "^2.26.0",
    "@tanstack/vue-query": "^4.44.0",
    "axios": "^1.19.0",
    "vue": "^3.5.41",
    "vue-router": "~5.1.0"
  },
  "devDependencies": {
    "@formkit/themes": "2.1.0",
    "@halo-dev/ui-plugin-bundler-kit": "^2.26.0",
    "@iconify-json/logos": "^1.2.13",
    "@iconify-json/mingcute": "^1.2.8",
    "@iconify-json/ri": "^1.2.10",
    "@iconify-json/simple-icons": "^1.2.93",
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/eslint-plugin": "^1.6.23",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.77.0",
    "eslint-plugin-vue": "~10.9.2",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.2",
    "oxlint": "~1.77.0",
    "prettier": "3.9.6",
    "typescript": "~6.0.0",
    "unocss": "^66.8.1",
    "unplugin-icons": "^23.0.1",
    "vite": "^8.2.2",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.10"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
